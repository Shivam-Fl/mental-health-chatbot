# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google AI Configuration (Vertex AI REST API)
VERTEX_AI_API_KEY=your_vertex_ai_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Vertex AI region — use the nearest region to minimise latency.
# Closest to India: asia-south1 (Mumbai). Other options: us-central1, europe-west4.
# Leave unset or empty to fall back to the global endpoint.
VERTEX_AI_REGION=asia-south1

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/chat

# Encryption Key for Chat Messages (generate with: openssl rand -base64 32)
CHAT_ENCRYPTION_KEY=your_32_byte_encryption_key_here
